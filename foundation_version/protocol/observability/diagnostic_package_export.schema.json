{
  "schema_version": 1,
  "title": "Diagnostic package export request",
  "type": "object",
  "required": [
    "schema_version",
    "package_kind",
    "created_utc",
    "correlation_id",
    "retention_limit",
    "payload_bodies_included",
    "collection",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "package_kind": {
      "const": "scilab-jcef-diagnostic"
    },
    "payload_bodies_included": {
      "const": false
    },
    "files": {
      "type": "array",
      "minItems": 10
    },
    "retention_limit": {
      "type": "integer",
      "maximum": 200
    }
  }
}
